# This is a basic workflow to help you get started with Actions

name: CI

# Controls when the workflow will run
on:
  # Triggers the workflow on push or pull request events but only for the "master" branch
  push:
    branches: [ "master" ]
  pull_request:
    branches: [ "master" ]

  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:

# A workflow run is made up of one or more jobs that can run sequentially or in parallel
jobs:
  # This workflow contains a single job called "build"
  build:
    # The type of runner that the job will run on
    runs-on: self-hosted

    # Steps represent a sequence of tasks that will be executed as part of the job
    steps:
      # Checks-out your repository under $GITHUB_WORKSPACE, so your job can access it
      - uses: actions/checkout@v4

      # Set Execution Policy to Bypass (IMPORTANT: Before any PowerShell script execution)
      - name: Set Execution Policy to Bypass
        run: Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
        shell: powershell

      # Runs a single command using the runners shell (using PowerShell)
      - name: Run a one-line script
        run: Write-Host "Hello, world!"
        shell: powershell  # Важно: Укажите powershell

      # Runs a set of commands using the runners shell (using PowerShell)
      - name: Run a multi-line script
        run: |
          Write-Host "Add other actions to build,"
          Write-Host "test, and deploy your project."
        shell: powershell  # Важно: Укажите powershell
